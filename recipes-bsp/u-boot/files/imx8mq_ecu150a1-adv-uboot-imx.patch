diff --git a/board/freescale/imx8mq_evk/imx8mq_evk.env b/board/freescale/imx8mq_evk/imx8mq_evk.env
index 2bc82db830f..ef3899b94ba 100644
--- a/board/freescale/imx8mq_evk/imx8mq_evk.env
+++ b/board/freescale/imx8mq_evk/imx8mq_evk.env
@@ -22,6 +22,7 @@ boot_fdt=try
 boot_targets=usb0 mmc1 mmc2 dhcp
 bootm_size=0x10000000
 console=ttymxc0,115200
+earlycon=ec_imx6q,0x30860000,115200
 splashimage=0x50000000
 fdt_addr=0x43000000
 fdt_addr_r=0x43000000
@@ -52,9 +53,9 @@ jh_mmcboot=setenv fdtfile imx8mq-evk-root.dtb;
 		run mmcboot;
 	else run jh_netboot; fi;
 jh_netboot=setenv fdtfile imx8mq-evk-root.dtb; setenv jh_clk kvm.enable_virt_at_load=false clk_ignore_unused mem=1872M; run netboot;
-mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}
-loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}
-loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}
+mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} earlycon=${earlycon} root=${mmcroot}
+loadimage=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}
+loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}
 mmcboot=echo Booting from mmc ...;
 	run mmcargs;
 	if test ${boot_fdt} = yes || test ${boot_fdt} = try; then
@@ -66,7 +67,30 @@ mmcboot=echo Booting from mmc ...;
 	else
 		echo wait for boot;
 	fi;
-netargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=/dev/nfs
+emmcboot=echo Booting from emmc ...; setenv mmcdev 0; setenv mmcroot /dev/mmcblk0p2 rootwait rw;
+	run mmcargs;
+	mmc dev ${mmcdev};
+	if run loadimage; then
+		if run loadfdt; then
+			booti ${loadaddr} - ${fdt_addr_r};
+		fi;
+	fi;
+advufile=advupdate.txt
+ramrootfstype=ext2 rootwait
+loadramdisk=load mmc ${mmcdev} ${initrd_addr} ramdisk.gz
+advrargs=setenv bootargs console=${console} ${optargs} root=/dev/ram0 rw ramdisk_size=65536 initrd=${initrd_addr},64M rootfstype=${ramrootfstype}
+advrfs=echo Advantech recovery file system ramdisk ...;
+	setenv devnum ${mmcdev};
+	setenv devtype mmc;
+	run loadimage;
+	run loadramdisk;
+	run advrargs;
+	if run loadfdt; then
+		booti ${loadaddr} - ${fdt_addr_r};
+	else
+		booti ${loadaddr};
+	fi
+netargs=setenv bootargs ${jh_clk} console=${console} root=/dev/nfs
 	ip=dhcp nfsroot=${serverip}:${nfsroot},v3,tcp
 netboot=echo Booting from net ...;
 	run netargs;
@@ -91,6 +115,7 @@ bsp_bootcmd=setenv opteeoverlay yes;echo Running BSP bootcmd ...;
 		else
 			run netboot;
 		fi;
+	else run emmcboot;
 	fi;
 
 #endif
